# Which upstream PebbleOS release to build.
#   latest  = the highest vX.YY.Z full release (pre-releases, drafts and v4.9.x recovery builds are skipped)
#   v4.44.  = stay on one release line (any prefix of the tag works)
TRACK=latest

# Watch board: obelix@pvt is a retail Pebble Time 2.
BOARD=obelix@pvt
