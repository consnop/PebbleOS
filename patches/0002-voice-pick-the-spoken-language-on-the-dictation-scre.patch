index a4681d5..f0be236 100644
--- a/pebble/services/voice/voice.c
+++ b/pebble/services/voice/voice.c
@@ -25,6 +25,7 @@
 
 #include <kernel/events.h>
 #include <process_management/app_manager.h>
+#include <shell/prefs.h>
 
 PBL_LOG_MODULE_DEFINE(service_voice, CONFIG_SERVICE_VOICE_LOG_LEVEL);
 
@@ -56,6 +57,16 @@ static Uuid s_app_uuid;
 
 static AudioEndpointSessionId s_session_id = AUDIO_ENDPOINT_SESSION_INVALID_ID;
 
+static const char s_language_codes[VoiceLanguageCount][VOICE_LANGUAGE_CODE_LEN] = {
+  [VoiceLanguageSlovak] = {'s', 'k'},
+  [VoiceLanguageEnglish] = {'e', 'n'},
+  [VoiceLanguageGerman] = {'d', 'e'},
+};
+static VoiceLanguage s_language = VoiceLanguageCount; // VoiceLanguageCount: not read from prefs yet
+
+static void prv_store_language(struct pbl_work *work);
+static PBL_WORK_DEFINE(s_store_language_work, prv_store_language);
+
 static void prv_session_setup_timeout(struct pbl_work *work);
 static void prv_session_result_timeout(struct pbl_work *work);
 static PBL_DELAYED_WORK_DEFINE(s_setup_timeout, prv_session_setup_timeout);
@@ -441,8 +452,9 @@ VoiceSessionId voice_start_dictation(VoiceEndpointSessionType session_type) {
 
   PBL_LOG_INFO("Send session setup message. Session type: %d", session_type);
   PBL_LOG_DBG("Calling voice_endpoint_setup_session");
-  voice_endpoint_setup_session(session_type, s_session_id, &transfer_info,
-                               s_from_app ? &s_app_uuid : nullptr);
+  voice_endpoint_setup_session_with_language(session_type, s_session_id, &transfer_info,
+                                             s_from_app ? &s_app_uuid : nullptr,
+                                             s_language_codes[voice_get_language()]);
 
   s_timeout_generation = s_session_generation;
   pbl_delayed_work_cancel(&s_result_timeout);
@@ -751,6 +763,41 @@ unlock:
   pbl_mutex_unlock(&s_lock);
 }
 
+VoiceLanguage voice_get_language(void) {
+  if (s_language >= VoiceLanguageCount) {
+    const uint8_t stored = shell_prefs_get_dictation_language();
+    s_language = (stored < VoiceLanguageCount) ? (VoiceLanguage)stored : VoiceLanguageEnglish;
+  }
+  return s_language;
+}
+
+// Settings file writes happen off the caller's task: the caller may be an app on its own stack.
+static void prv_store_language(struct pbl_work *work) {
+  shell_prefs_set_dictation_language(voice_get_language());
+}
+
+void voice_set_language(VoiceLanguage language) {
+  if (language >= VoiceLanguageCount) {
+    return;
+  }
+  pbl_mutex_lock(&s_lock, PBL_FOREVER);
+  s_language = language;
+  // Every state past Idle has sent its setup message (voice_start_dictation holds the lock)
+  if ((s_state != SessionState_Idle) && (s_session_id != AUDIO_ENDPOINT_SESSION_INVALID_ID)) {
+    voice_endpoint_send_language(s_session_id, s_language_codes[language]);
+  }
+  pbl_mutex_unlock(&s_lock);
+  pbl_work_submit(&pbl_sys_workq, &s_store_language_work);
+}
+
+PBL_SYSCALL(VoiceLanguage, sys_voice_get_language) {
+  return voice_get_language();
+}
+
+PBL_SYSCALL(void, sys_voice_set_language, (VAL, VoiceLanguage, language)) {
+  voice_set_language(language);
+}
