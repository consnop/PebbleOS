 }
@@ -1217,6 +1271,15 @@ static void prv_mic_window_load(Window *window) {
   layer_add_child(&window->layer, (Layer *)loading_layer);
   layer_set_hidden((Layer *)loading_layer, true);
 
+  data->mic_window.language = sys_voice_get_language();
+  Layer *language_layer = layer_create(GRect(0, STATUS_BAR_LAYER_HEIGHT + LANGUAGE_ROW_MARGIN,
+                                             root_frame->size.w, LANGUAGE_CELL_SIZE.h));
+  if (language_layer) {
+    layer_set_update_proc(language_layer, prv_language_layer_update_proc);
+    layer_add_child(root_layer, language_layer);
+  }
+  data->mic_window.language_layer = language_layer;
+
   StatusBarLayer *status_bar = &data->mic_window.status_bar;
   status_bar_layer_init(status_bar);
   const GColor status_bg_color = PBL_IF_COLOR_ELSE(GColorLightGray, GColorWhite);
@@ -1283,6 +1346,8 @@ static void prv_mic_window_unload(Window *window) {
   kino_layer_deinit(&data->mic_window.icon_layer);
   loading_layer_deinit(&data->mic_window.progress_bar);
   layer_deinit(&data->mic_window.mic_dot_layer);
+  layer_destroy(data->mic_window.language_layer);
+  data->mic_window.language_layer = nullptr;
   text_layer_deinit(&data->mic_window.text_layer);
   status_bar_layer_deinit(&data->mic_window.status_bar);
   event_service_client_unsubscribe(&data->voice_event_sub);
