+static void prv_test_session_setup_with_language_msg(uint16_t endpoint_id, const uint8_t *data,
+                                                     unsigned int length) {
+  cl_assert_equal_i(endpoint_id, 11000);
+  const size_t speex_attr_len = sizeof(struct pbl_generic_attr) + sizeof(AudioTransferInfoSpeex);
+  cl_assert_equal_i(length, sizeof(SessionSetupMsg) + speex_attr_len +
+                                sizeof(struct pbl_generic_attr) + VOICE_LANGUAGE_CODE_LEN);
+
+  SessionSetupMsg *msg = (SessionSetupMsg *)data;
+  cl_assert_equal_i(msg->msg_id, MsgIdSessionSetup);
+  cl_assert_equal_i(msg->session_id, s_session_id);
+  cl_assert_equal_i(msg->attr_list.num_attributes, 2);
+
+  // The language follows the speex info, so phones that read attributes in order still see it first
+  const uint8_t expected_language_attr[] = {0x40, 0x02, 0x00, 's', 'k'};
+  cl_assert_equal_m((uint8_t *)msg->attr_list.attributes + speex_attr_len, expected_language_attr,
+                    sizeof(expected_language_attr));
+}
+
+void test_voice_endpoint__send_session_setup_with_language(void) {
+  fake_transport_set_sent_cb(s_transport, prv_test_session_setup_with_language_msg);
+
+  AudioTransferInfoSpeex transfer_info = (AudioTransferInfoSpeex){
+    .sample_rate = 16000,
+    .bit_rate = 12800,
+    .frame_size = 320,
+    .bitstream_version = 4
+  };
+  s_session_id = 7;
+  voice_endpoint_setup_session_with_language(VoiceEndpointSessionTypeDictation, s_session_id,
+                                             &transfer_info, nullptr, "sk");
+  fake_comm_session_process_send_next();
+}
+
+static void prv_test_language_msg(uint16_t endpoint_id, const uint8_t *data, unsigned int length) {
+  cl_assert_equal_i(endpoint_id, 11000);
+  const uint8_t expected[] = {
+    0x40,                   // Message ID: session language
+    0x00, 0x00, 0x00, 0x00, // flags
+    0x07, 0x00,             // session id
+    0x01,                   // attribute count
+    0x40, 0x02, 0x00,       // attribute id, length
+    'd',  'e',
+  };
+  cl_assert_equal_i(length, sizeof(expected));
+  cl_assert_equal_m(data, expected, sizeof(expected));
+}
+
+void test_voice_endpoint__send_language(void) {
+  fake_transport_set_sent_cb(s_transport, prv_test_language_msg);
+  voice_endpoint_send_language(7, "de");
+  fake_comm_session_process_send_next();
+}
