 PBL_SYSCALL(VoiceSessionId, sys_voice_start_dictation,
             (VAL, VoiceEndpointSessionType, session_type)) {
   if ((session_type >= VoiceEndpointSessionTypeCount) ||
diff --git a/pebble/services/voice_endpoint/service.c b/pebble/services/voice_endpoint/service.c
index b9a01a3..42c1193 100644
--- a/pebble/services/voice_endpoint/service.c
+++ b/pebble/services/voice_endpoint/service.c
@@ -216,6 +216,13 @@ void voice_endpoint_protocol_msg_callback(struct pbl_pp_session *session, const
 void voice_endpoint_setup_session(VoiceEndpointSessionType session_type,
                                   AudioEndpointSessionId session_id, AudioTransferInfoSpeex *info,
                                   Uuid *app_uuid) {
+  voice_endpoint_setup_session_with_language(session_type, session_id, info, app_uuid, nullptr);
+}
+
+void voice_endpoint_setup_session_with_language(VoiceEndpointSessionType session_type,
+                                                AudioEndpointSessionId session_id,
+                                                AudioTransferInfoSpeex *info, Uuid *app_uuid,
+                                                const char *language) {
   struct pbl_pp_session *comm_session = pbl_pp_session_get_system();
   pbl_pp_session_set_responsiveness(comm_session, PBL_BT_CONSUMER_PP_VOICE_ENDPOINT,
                                     PBL_BT_RESPONSE_TIME_MIN,
@@ -224,7 +231,8 @@ void voice_endpoint_setup_session(VoiceEndpointSessionType session_type,
   // We're only sending one attribute now: the speex audio transfer info packet
   size_t size = sizeof(SessionSetupMsg) + sizeof(struct pbl_generic_attr) +
                 sizeof(AudioTransferInfoSpeex) +
-                (app_uuid ? (sizeof(Uuid) + sizeof(struct pbl_generic_attr)) : 0);
+                (app_uuid ? (sizeof(Uuid) + sizeof(struct pbl_generic_attr)) : 0) +
+                (language ? (VOICE_LANGUAGE_CODE_LEN + sizeof(struct pbl_generic_attr)) : 0);
   SessionSetupMsg *msg = pbl_malloc_check(size);
   *msg = (SessionSetupMsg){
     .msg_id = MsgIdSessionSetup,
@@ -249,9 +257,33 @@ void voice_endpoint_setup_session(VoiceEndpointSessionType session_type,
   attr = pbl_generic_attr_add(attr, VEAttributeIdAudioTransferInfoSpeex, info,
                               sizeof(AudioTransferInfoSpeex));
 
+  if (language) {
+    msg->attr_list.num_attributes += 1;
+    attr = pbl_generic_attr_add(attr, VEAttributeIdLanguage, language, VOICE_LANGUAGE_CODE_LEN);
+  }
+
   size_t actual_size = (uint8_t *)attr - (uint8_t *)msg;
   PBL_ASSERTN(actual_size == size);
 
   pbl_pp_send(comm_session, PBL_PP_ENDPOINT_VOICE, (uint8_t *)msg, size, PBL_PP_DEFAULT_TIMEOUT_MS);
   pbl_free(msg);
 }
+
+void voice_endpoint_send_language(AudioEndpointSessionId session_id, const char *language) {
+  struct pbl_pp_session *comm_session = pbl_pp_session_get_system();
+  if (!comm_session) {
+    return;
+  }
+  const size_t size =
+      sizeof(SessionLanguageMsg) + sizeof(struct pbl_generic_attr) + VOICE_LANGUAGE_CODE_LEN;
+  SessionLanguageMsg *msg = pbl_malloc_check(size);
+  *msg = (SessionLanguageMsg){
+    .msg_id = MsgIdSessionLanguage,
+    .session_id = session_id,
+    .attr_list.num_attributes = 1,
+  };
+  pbl_generic_attr_add(msg->attr_list.attributes, VEAttributeIdLanguage, language,
+                       VOICE_LANGUAGE_CODE_LEN);
+  pbl_pp_send(comm_session, PBL_PP_ENDPOINT_VOICE, (uint8_t *)msg, size, PBL_PP_DEFAULT_TIMEOUT_MS);
+  pbl_free(msg);
+}
