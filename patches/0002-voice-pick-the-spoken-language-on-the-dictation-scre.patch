@@ -887,6 +887,58 @@ static void prv_shrink_progress_bar(VoiceUiData *data) {
   animation_schedule((Animation *)data->mic_window.progress_anim);
 }
 
+static const char *const s_language_labels[VoiceLanguageCount] = {
+  [VoiceLanguageSlovak] = "SK",
+  [VoiceLanguageEnglish] = "EN",
+  [VoiceLanguageGerman] = "DE",
+};
+
+#define LANGUAGE_CELL_SIZE  ((GSize){.w = 46, .h = 30})
+#define LANGUAGE_CELL_GAP   (6)
+#define LANGUAGE_ROW_MARGIN (6)
+
+static void prv_language_layer_update_proc(Layer *layer, GContext *ctx) {
+  VoiceUiData *data = window_get_user_data(layer_get_window(layer));
+  const GFont font = fonts_get_system_font(FONT_KEY_GOTHIC_24_BOLD);
+  const GSize cell = LANGUAGE_CELL_SIZE;
+  const int16_t row_w = VoiceLanguageCount * cell.w + (VoiceLanguageCount - 1) * LANGUAGE_CELL_GAP;
+  GRect frame = {.origin.x = (layer->bounds.size.w - row_w) / 2, .size = cell};
+  for (VoiceLanguage language = 0; language < VoiceLanguageCount; language++) {
+    const bool selected = (language == data->mic_window.language);
+    if (selected) {
+      graphics_context_set_fill_color(ctx, GColorBlack);
+      graphics_fill_round_rect(ctx, &frame, 4, GCornersAll);
+    }
+    graphics_context_set_text_color(
+        ctx, selected ? GColorWhite : PBL_IF_COLOR_ELSE(GColorDarkGray, GColorBlack));
+    // Gothic's ascent leaves room above the caps; lift the text to centre them in the cell
+    GRect text_frame = grect_inset(frame, GEdgeInsets(-4, 0, 0, 0));
+    graphics_draw_text(ctx, s_language_labels[language], font, text_frame,
+                       GTextOverflowModeTrailingEllipsis, GTextAlignmentCenter, nullptr);
+    frame.origin.x += cell.w + LANGUAGE_CELL_GAP;
+  }
+}
+
+// Up and Down cycle the spoken language, at any point while the mic window is up
+static void prv_language_click_handler(ClickRecognizerRef recognizer, void *context) {
+  VoiceUiData *data = context;
+  const int step = (click_recognizer_get_button_id(recognizer) == BUTTON_ID_UP) ? -1 : 1;
+  const VoiceLanguage language =
+      (VoiceLanguage)((data->mic_window.language + VoiceLanguageCount + step) % VoiceLanguageCount);
+  data->mic_window.language = language;
+  sys_voice_set_language(language);
+  if (data->mic_window.language_layer) {
+    layer_mark_dirty(data->mic_window.language_layer);
+  }
+}
+
+static void prv_language_click_config(void *context) {
+  window_set_click_context(BUTTON_ID_UP, context);
+  window_single_click_subscribe(BUTTON_ID_UP, &prv_language_click_handler);
+  window_set_click_context(BUTTON_ID_DOWN, context);
+  window_single_click_subscribe(BUTTON_ID_DOWN, &prv_language_click_handler);
+}
+
 static void prv_mic_click_handler(ClickRecognizerRef recognizer, void *context) {
   VoiceUiData *data = context;
   ButtonId button_id = click_recognizer_get_button_id(recognizer);
@@ -905,6 +957,7 @@ static void prv_mic_click_handler(ClickRecognizerRef recognizer, void *context)
 }
 
 static void prv_back_select_click_config_provider(void *context) {
